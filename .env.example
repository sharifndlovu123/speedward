# Copy to .env in the folder you run speedward from. Never commit .env.
# Only these keys are read from .env. GLOBALPING_BASE_URL is deliberately not one of them.

# Globalping key, server-side only. Optional: without one you get 250 tests/hour and 50 locations.
# A key is free up to a limit (500 tests/hour, up to 500 locations; credits beyond that).
# Get one at https://globalping.io
GLOBALPING_TOKEN=

# Line colours on the map (first byte, in milliseconds): green up to FAST_MS, red from SLOW_MS.
# SLOW_MS must be above FAST_MS. Used by the web UI, HTML exports and CLI HTML reports.
FAST_MS=300
SLOW_MS=800

# Offline position of the server that answered each place (optional, needs: pip install -e ".[geoip]";
# the Docker image has it). Path to a MaxMind GeoLite2 City or DB-IP Lite City .mmdb file.
# This is a host path for runs without Docker, e.g. GEOIP_DB=/home/you/geo/GeoLite2-City.mmdb
# (scripts/update_geoip.sh keeps that file current). docker-compose.yml ignores it and uses
# /geo/GeoLite2-City.mmdb inside the container.
GEOIP_DB=
# Or set the position of the site's server by hand (decimal degrees). Wins for the one Server square.
SERVER_LAT=
SERVER_LON=

# "Where the time goes" and "Is it fast?" thresholds (README "Settings" lists the bounds). Leave empty for
# the defaults shown. A bad value stops the web UI or a scan at start with an error naming the setting.
# Shares are fractions of the total (0.40 = 40%).
BIGGEST_SHARE=
POSSIBLE_SHARE=
# Places needed for any conclusion (whole number, never below 3). Default 3.
MIN_PLACES=
# Close to the server: connect under this many ms. Default 40.
NEAR_CONNECT_MS=
# Grows with distance: correlation at least this (default 0.7) and a spread of at least this many ms (default 50).
DISTANCE_CORRELATION=
DISTANCE_SPREAD_MS=
# "DNS is large" in a place at this share of its total. Default 0.25.
DNS_SHARE=
# Consistency varies: slowest run at least VARIES_RATIO times the median (default 2) and VARIES_MIN_MS above it (default 50).
VARIES_RATIO=
VARIES_MIN_MS=
# Path: bad hop at this % loss carried to the site (default 10); long link at a rise of this many ms (default 50).
BAD_HOP_LOSS_PCT=
LONG_LINK_MS=

# --- Web UI only ---
# How long the browser keeps results, in seconds (minimum 60).
RESULT_TTL_SECONDS=900
# Scans running at once on this server (minimum 1).
MAX_CONCURRENT_SCANS=2
# Required when DEBUG is off (the server refuses to start without it). Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Host names the web UI answers to, comma-separated. This is not access control.
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins, comma-separated, needed when served over HTTPS, e.g. https://speed.example.com
CSRF_TRUSTED_ORIGINS=
# Local development only. Never expose a DEBUG=1 instance.
DEBUG=0

# --- docker compose only: MaxMind geoipupdate (passed to the geoipupdate container alone) ---
# Free GeoLite2 account and licence key from maxmind.com. The licence key is a secret like
# GLOBALPING_TOKEN: keep it out of the repository and logs. Leave both empty if you use
# docker-compose.secrets.yml (files in ./secrets/) instead; use one route, not both.
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
# Space-separated MaxMind edition IDs; speedward needs only the City database.
GEOIPUPDATE_EDITION_IDS=GeoLite2-City
