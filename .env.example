# Copy to .env in the folder you run speedward from. Never commit .env.
# Only these keys are read from .env. GLOBALPING_BASE_URL is deliberately not one of them.

# Globalping key, server-side only. Optional: without one you get 250 tests/hour and 50 locations;
# a free key gives 500 tests/hour and up to 500 locations. Get one at https://globalping.io
GLOBALPING_TOKEN=

# Timing colours and pass marks, in milliseconds. SLOW_MS must be above FAST_MS.
FAST_MS=300
SLOW_MS=800

# Offline position of the server that answered each place (optional, needs: pip install -e ".[geoip]";
# the Docker image has it). Path to a MaxMind GeoLite2 City or DB-IP Lite City .mmdb file.
# Docker: mount it, e.g. -v /srv/geo:/geo:ro, and set GEOIP_DB=/geo/GeoLite2-City.mmdb
GEOIP_DB=
# Or set the position of the site's server by hand (decimal degrees). Wins for the one Server square.
SERVER_LAT=
SERVER_LON=

# --- Web UI only ---
# How long the browser keeps results, in seconds (minimum 60).
RESULT_TTL_SECONDS=900
# Scans running at once on this server (minimum 1).
MAX_CONCURRENT_SCANS=2
# Required when DEBUG is off (the server refuses to start without it). Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Host names the web UI answers to, comma-separated. This is not access control.
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins, comma-separated, needed when served over HTTPS, e.g. https://speed.example.com
CSRF_TRUSTED_ORIGINS=
# Local development only. Never expose a DEBUG=1 instance.
DEBUG=0
