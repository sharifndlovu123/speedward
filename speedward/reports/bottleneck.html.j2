{#- "Where the time goes": shared by the HTML export and the web UI. Autoescaped; every value is text.
    The path is an ordered list (read in order by screen readers); the to-scale bar repeats it and is
    hidden from them. Marks are told by outline, pattern and a text label, never by colour alone. -#}
{% macro diagram(g) -%}
<p class="bn-cap">{{ g.caption }}</p>
{% if g.reason %}<p class="bn-reason">{{ g.reason }}</p>{% endif %}
<ol class="bn-path" aria-label="{{ g.label }}">
<li class="bn-block bn-visitor"><span class="bn-k">Visitor</span><b>{{ g.visitor[0] }}</b><span class="bn-n">{{ g.visitor[1] }}</span></li>
{% for b in g.blocks %}{% if b.stage == "server_wait" %}<li class="bn-block bn-edge"><span class="bn-k">Edge / CDN · seen, not timed</span><b>{{ g.edge.title }}</b><span class="bn-n">{{ g.edge.note }}</span></li>
{% endif %}<li class="bn-block bn-{{ b.mark }}"><span class="bn-k">{{ b.n }} · {{ b.name }}{% if b.flag %} · <strong>{{ b.flag }}</strong>{% endif %}</span><b class="bn-ms">{{ b.ms }}</b><span class="bn-n">{{ b.note }}</span></li>
{% endfor %}</ol>
{% if g.bar %}<div class="bn-bar" aria-hidden="true">{% for s in g.bar %}<span class="bn-seg bn-{{ s.mark }}" style="width:{{ s.pct }}%"></span>{% endfor %}</div>
<p class="bn-scale">{{ g.scale }}</p>{% endif %}
{%- endmacro %}
<section class="bottleneck" aria-label="Where the time goes">
<style>{{ css }}</style>
<div class="bn-head">
<p class="bn-kicker">{{ v.kicker }}</p>
<p class="bn-headline">{{ v.headline }}</p>
<p class="bn-detail">{{ v.detail }}</p>
{% if interactive and v.overall %}<button type="button" class="secondary" data-bn-open>See the request path</button>{% endif %}
</div>
<div class="bn-body">
<{{ h }} class="bn-title" tabindex="-1">Where the time goes</{{ h }}>
{% if v.overall %}
{% if interactive %}<div class="bn-showing"><p aria-live="polite">Showing: <span data-bn-showing>{{ v.average_label }}</span></p><button type="button" class="secondary" data-bn-show="all" hidden>Show the average</button></div>{% endif %}
<div class="bn-view" data-bn-view="all">
{{ diagram(v.overall) }}
{% if v.checks %}<div class="bn-checks">{% for c in v.checks %}<div><p class="bn-k">{{ c.title }}</p><p>{{ c.text }}</p></div>{% endfor %}</div>{% endif %}
</div>
{% if interactive %}{% for p in v.places %}<div class="bn-view" data-bn-view="{{ p.row }}" hidden>
{% if p.diagram %}{{ diagram(p.diagram) }}{% else %}<p class="bn-cap">{{ p.name }}</p><p class="bn-reason">{{ p.reason }}</p>{% endif %}
</div>
{% endfor %}{% endif %}
<ul class="bn-key" aria-label="Key">{% for k, text in v.key %}<li><span class="bn-swatch bn-{{ k }}" aria-hidden="true"></span>{{ text }}</li>{% endfor %}</ul>
{% endif %}
<div class="bn-cards">{% for c in v.cards %}<div class="bn-card"><p class="bn-k">{{ c.kicker }}</p><p class="bn-card-title">{{ c.title }}</p><p>{{ c.text }}</p><p class="bn-check">{{ c.check }}</p></div>{% endfor %}</div>
<p class="bn-k">Each place, by what holds it back</p>
<ul class="bn-places">
{% for p in v.places %}<li class="bn-place{% if not p.measured %} bn-out{% endif %}">
{% if interactive %}<button type="button" class="bn-pick" data-bn-show="{{ p.row }}"><span class="bn-pname">{{ p.name }}</span>{% if p.measured %}<span class="bn-mini" aria-hidden="true">{% for s in p.segments %}<span class="bn-seg bn-{{ s.mark }}" style="width:{{ s.pct }}%"></span>{% endfor %}</span><span class="bn-tag">{{ p.tag }}{% if p.total %} · {{ p.total }}{% endif %}</span>{% else %}<span class="bn-tag">{{ p.reason }}</span>{% endif %}</button>
{% elif p.diagram %}<details><summary><span class="bn-pname">{{ p.name }}</span><span class="bn-tag">{{ p.tag }} · {{ p.total }}</span></summary>{{ diagram(p.diagram) }}</details>
{% else %}<p><span class="bn-pname">{{ p.name }}</span><span class="bn-tag">{{ p.reason }}</span></p>
{% endif %}</li>
{% endfor %}</ul>
<p class="bn-foot">{{ v.footnote }}</p>
</div>
</section>
