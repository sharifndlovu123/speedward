{#- "Who can reach it": shared by the HTML export and the web UI. Autoescaped; every value is text.
    Each cell is a symbol and a word; no colour carries meaning. -#}
<section class="reach" aria-label="Who can reach it">
<style>{{ css }}</style>
{% if not interactive %}<{{ h }} class="rc-title">Who can reach it</{{ h }}>{% endif %}
<div class="rc-head">
<p class="rc-kicker">{{ v.kicker }}</p>
<div class="rc-finding"><p>{{ v.finding }}</p>{% if v.check %}<p class="rc-check">{{ v.check }}</p>{% endif %}</div>
{% if interactive %}<button type="button" class="secondary" data-rc-open>See who can reach it</button>{% endif %}
</div>
<div class="rc-body">
{% if interactive %}<{{ h }} class="rc-title" tabindex="-1">Who can reach it</{{ h }}>{% endif %}
<div class="scroll" tabindex="0" role="region" aria-label="Who can reach it, by place"><table class="rc-grid">
<thead><tr><th scope="col">Place</th>{% for hd in v.headers %}<th scope="col">{{ hd }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in v.rows %}<tr data-row="{{ r.row }}"><th scope="row">{{ r.place }}</th>{% for c in r.cells %}<td class="rc-{{ c.state }}"><span class="rc-sym" aria-hidden="true">{{ c.symbol }}</span> <b>{{ c.word }}</b>{% if c.detail %} <span class="rc-detail">{{ c.detail }}</span>{% endif %}</td>{% endfor %}</tr>
{% endfor %}</tbody></table></div>
<p class="rc-key">{{ v.key }}</p>
{% if v.resolvers %}<p class="rc-key">{{ v.resolvers }}.</p>{% endif %}
</div>
</section>
